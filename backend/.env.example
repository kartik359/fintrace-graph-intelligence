# ===================================================
# FinTrace: CognoDB Connection Configuration
# ===================================================
# 1. Sign up for free tier at https://console.cognodb.com/signup
# 2. Create a free (c0) instance
# 3. Paste the generated Bolt URI & password below:

COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_generated_password_here

# Application Port
PORT=5000
NODE_ENV=development
